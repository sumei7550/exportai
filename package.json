{
  "name": "exportai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode content-script",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pdf-render:sample": "vitest run src/tests/pdf-render-sample.test.ts",
    "test:pdf-render": "npm run test:pdf-render:sample && node scripts/pdf-render-validation.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "pdfmake": "0.3.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.3.0",
    "@types/pdfmake": "0.2.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "fontmin": "1.1.1",
    "jsdom": "^30.0.1",
    "jspdf-font": "1.0.7",
    "otf2ttf": "1.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  }
}
