{
  "manifest_version": 3,
  "name": "ExportAI",
  "description": "Export AI conversations locally as PDF, Markdown, or JSON.",
  "version": "0.1.0",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "ExportAI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
